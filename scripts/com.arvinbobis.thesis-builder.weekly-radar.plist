<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unique identifier for this job -->
    <key>Label</key>
    <string>com.arvinbobis.thesis-builder.weekly-radar</string>

    <!-- The command to run -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/arvinbobis/Programs/thesis-builder/scripts/weekly-radar.sh</string>
    </array>

    <!-- Run every Monday at 08:00 local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Run from the project directory -->
    <key>WorkingDirectory</key>
    <string>/Users/arvinbobis/Programs/thesis-builder</string>

    <!-- Capture stdout and stderr -->
    <key>StandardOutPath</key>
    <string>/Users/arvinbobis/Programs/thesis-builder/logs/weekly-radar.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/arvinbobis/Programs/thesis-builder/logs/weekly-radar.log</string>

    <!-- Run even if the user is not logged in at boot -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
